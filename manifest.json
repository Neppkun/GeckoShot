{
  "manifest_version": 3,
  "name": "GeckoShot",
  "description": "Select any part of a page and copy or save it as an image. Based on the Screenshots feature from Mozilla Firefox.",
  "version": "1.0.0",
  "default_locale": "en",
  "minimum_chrome_version": "123",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "__MSG_screenshot_toolbar_button_label__"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      }
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "clipboardWrite",
    "downloads",
    "notifications",
    "storage"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/screenshots.css",
        "content/icons/*.svg",
        "content/clipboard.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
